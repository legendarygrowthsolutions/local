{
  "name": "local",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "next build && playwright test",
    "e2e:run": "playwright test",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:demo": "tsx scripts/db.ts demo",
    "db:reset": "tsx scripts/db.ts reset",
    "db:ensure": "tsx scripts/db.ts ensure",
    "db:schema": "tsx scripts/db.ts schema",
    "crawl": "npm run crawl:district && npm run crawl:khelomore && npm run crawl:build",
    "crawl:district": "node scripts/crawl/district.mjs",
    "crawl:khelomore": "node scripts/crawl/khelomore.mjs",
    "crawl:build": "node scripts/crawl/build.mjs",
    "predev": "npm run db:ensure",
    "test:postgres": "TEST_DB=postgres vitest run",
    "test:mysql": "TEST_DB=mysql vitest run",
    "test:libsql": "TEST_DB=libsql vitest run",
    "e2e:providers": "RAZORPAY_CHECKOUT_SRC=http://localhost:3299/v1/checkout.js next build && playwright test -c playwright.providers.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "kysely": "^0.29.6",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.9",
    "@libsql/client": "^0.18.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "mysql2": "^3.24.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
