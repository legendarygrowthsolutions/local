# Copy to .env.local for development. Nothing is required to run locally.

# --- Database -------------------------------------------------------------
# Any SQL database; the dialect is picked from the URL.
#   file:./data/local.db (default)     SQLite via better-sqlite3
#   postgres://user:pass@host/db       Postgres   (npm i pg)
#   mysql://user:pass@host/db          MySQL      (npm i mysql2)
#   libsql://your-db.turso.io          Turso      (npm i @libsql/kysely-libsql @libsql/client) + DATABASE_AUTH_TOKEN
#   libsql+file:./data/local.db        libSQL engine on a local file (same packages)
DATABASE_URL=file:./data/local.db
# DATABASE_AUTH_TOKEN=
# Migrations run automatically when the server starts; set to 0 to run `npm run db:migrate` yourself.
# DB_AUTO_MIGRATE=1

# --- Auth -----------------------------------------------------------------
# Secret for hashing one-time codes. Required in production (32+ characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET=

# How login codes are delivered:
#   dev    — no SMS; the code is logged and shown on the login screen (default outside production)
#   msg91  — MSG91 (India, DLT): MSG91_AUTH_KEY + MSG91_OTP_TEMPLATE_ID (flow template with ##otp##)
#   twilio — Twilio: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and TWILIO_FROM (or TWILIO_MESSAGING_SERVICE_SID);
#            WhatsApp codes need TWILIO_WHATSAPP_FROM + TWILIO_WHATSAPP_CONTENT_SID (approved template, {{1}} = code)
# Production with no configured provider refuses to send codes.
# OTP_PROVIDER=dev
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Your domain, for the Web OTP line that lets Android fill the code in (e.g. local.in)
# APP_HOST=

# Ceiling on login codes sent per hour across all numbers (SMS-pumping backstop).
# OTP_GLOBAL_HOURLY_CAP=2000

# Behind a proxy/CDN, the header it sets to the real client IP (used for rate limits),
# e.g. cf-connecting-ip, x-real-ip, x-vercel-forwarded-for.
# TRUSTED_IP_HEADER=

# Secure (HTTPS-only) cookies. Defaults to on in production.
# COOKIE_SECURE=1

# --- Payments ---------------------------------------------------------------
#   test     — built-in test gateway, no money moves (default outside production)
#   razorpay — live Razorpay Checkout: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET.
#              Point a Razorpay webhook (payment.captured, payment.failed, order.paid) at
#              https://<your-domain>/api/payments/razorpay/webhook
# Production with no configured gateway refuses to take payments.
# PAYMENT_PROVIDER=test
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Testing only -------------------------------------------------------------
# Multiplies every rate limit (the E2E suite logs in many times from one machine).
# RATE_LIMIT_SCALE=1
